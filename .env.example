# Resend — contact form transactional email
# 1. Create account: https://resend.com
# 2. Verify domain magnusmagi.com (DNS records under "Domains")
# 3. Create API key: https://resend.com/api-keys
RESEND_API_KEY=

# From address — must use a domain you have verified in Resend.
# Format: "Display Name <local-part@magnusmagi.com>"
CONTACT_FROM="Contact Form <hello@magnusmagi.com>"

# Where contact form messages get delivered.
CONTACT_TO=hello@magnusmagi.com

# Admin panel auth — gates /keystatic and /api/keystatic via signed cookie
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate via: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Google Search Console verification (optional)
# 1. Go to https://search.google.com/search-console
# 2. Add property -> magnusmagi.com -> HTML tag method
# 3. Copy only the content="XXX" value (just XXX) here
GOOGLE_SITE_VERIFICATION=
